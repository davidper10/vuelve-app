# Copia este archivo a .env y rellena tus propios valores si algún día
# cambias de proyecto Supabase. El .env real (con tus claves) ya está
# creado y NO se sube a git (mira .gitignore).

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-key
EXPO_PUBLIC_SENTRY_DSN=https://tu-clave@tu-org.ingest.sentry.io/tu-proyecto
EXPO_PUBLIC_POSTHOG_KEY=phc_tu-project-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_tu-clave-ios
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_tu-clave-android
