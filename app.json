{
  "expo": {
    "name": "SaveTrip",
    "slug": "vuelve-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vuelve",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vuelveapp.mobile",
      "associatedDomains": [
        "applinks:savetrip.vercel.app?mode=developer"
      ]
    },
    "android": {
      "package": "com.vuelveapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#D2E0C5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "savetrip.vercel.app",
              "pathPrefix": "/m"
            },
            {
              "scheme": "https",
              "host": "savetrip.vercel.app",
              "pathPrefix": "/unirse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vuelve usa tu ubicación para guardar dónde ocurrió cada recuerdo y mostrarlo en el mapa del viaje."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vuelve usa tus fotos para añadirlas a los recuerdos de tus viajes."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Vuelve usa NFC para vincular tus recuerdos a objetos físicos.",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C87554",
          "defaultChannel": "default"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "david-perez-ys",
          "project": "react-native"
        }
      ],
      "expo-localization",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
