{
  "expo": {
    "name": "Vuelve",
    "slug": "vuelve-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vuelve",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vuelveapp.mobile",
      "associatedDomains": ["applinks:vuelve-app.example.com"]
    },
    "android": {
      "package": "com.vuelveapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#68775C"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vuelve-app.example.com",
              "pathPrefix": "/m"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vuelve usa tu ubicación para guardar dónde ocurrió cada recuerdo y mostrarlo en el mapa del viaje."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Vuelve usa NFC para vincular tus recuerdos a objetos físicos.",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
