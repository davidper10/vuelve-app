{
  "expo": {
    "name": "SaveTrip",
    "slug": "vuelve-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vuelve",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vuelveapp.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.savetrip-app.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vuelveapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#D2E0C5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.savetrip-app.com",
              "pathPrefix": "/m"
            },
            {
              "scheme": "https",
              "host": "www.savetrip-app.com",
              "pathPrefix": "/unirse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NFC"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SaveTrip usa tu ubicación para guardar dónde ocurrió cada recuerdo y mostrarlo en el mapa del viaje."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SaveTrip usa tus fotos para añadirlas a los recuerdos de tus viajes."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "SaveTrip usa NFC para vincular tus recuerdos a objetos físicos.",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1079470289807-kuk8h04gckidbmngldjng655hbfh4b4o"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C87554",
          "defaultChannel": "default"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "david-perez-ys",
          "project": "react-native"
        }
      ],
      "expo-localization",
      "expo-video",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06763cc3-cb16-456f-9e96-10fb60d5bd08"
      }
    },
    "owner": "davidper10s-team"
  }
}
